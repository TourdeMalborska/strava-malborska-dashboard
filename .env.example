# .env.example — Tour de Malborska
#
# This file documents the environment variables the application reads.
# It contains KEY NAMES ONLY — never commit real values.
#
# Local development is managed through Infisical (project "tourdemalborska").
# Preferred: do NOT keep a real .env locally. Instead run:
#
#   infisical run --env=dev --path=/app -- uvicorn api.index:app --reload
#
# If you must materialize a local .env (e.g. offline), generate it with:
#
#   infisical export --env=dev --path=/app --format=dotenv > .env
#
# The real .env is gitignored. See SECRETS.md for the full inventory and the
# mapping to Infisical environments and folders.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Strava OAuth -----------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Optional: overrides the production callback URL for local/dev.
# Defaults in config.py to the Vercel production callback.
STRAVA_REDIRECT_URI=

# --- Sync / cron ------------------------------------------------------------
# Shared secret required by the /sync/daily cron endpoint (Bearer token).
CRON_SECRET=

# --- GitHub backup dispatch -------------------------------------------------
# PAT used by /sync/daily to trigger the backup-supabase.yml workflow.
GITHUB_BACKUP_TOKEN=

# --- COROS MCP probe (PoC) --------------------------------------------------
# Shared secret guarding the /test/coros/connection endpoint.
COROS_TEST_SECRET=
# Optional: defaults in coros_mcp.py to https://mcpeu.coros.com/mcp
COROS_MCP_URL=

# --- Test-only --------------------------------------------------------------
# Used only by the /activities test endpoint. Not needed for normal operation.
STRAVA_ACCESS_TOKEN=
