# .env.example — Tour de Malborska
#
# This file documents the environment variables the application reads.
# It contains KEY NAMES ONLY — never commit real values.
#
# Local development is managed through Infisical (project "tourdemalborska").
# Preferred: do NOT keep a real .env locally. Instead run:
#
#   infisical run --env=prod --path=/app -- uvicorn api.index:app --reload
#
# If you must materialize a local .env (e.g. offline), generate it with:
#
#   infisical export --env=prod --path=/app --format=dotenv > .env
#
# The real .env is gitignored. See SECRETS.md for the full inventory and the
# mapping to Infisical environments and folders.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Strava OAuth -----------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Optional: overrides the production callback URL for local/dev.
# Defaults in config.py to the Vercel production callback.
STRAVA_REDIRECT_URI=

# --- Sync / cron ------------------------------------------------------------
# Shared secret required by the /sync/daily cron endpoint (Bearer token).
CRON_SECRET=

# --- GitHub backup dispatch -------------------------------------------------
# PAT used by /sync/daily to trigger the backup-supabase.yml workflow.
GITHUB_BACKUP_TOKEN=

# --- COROS (MCP, OAuth + PKCE public client) ---------------------------------
# Public client: no client secret, security comes from PKCE.
COROS_CLIENT_ID=
# Optional: defaults to https://tourdemalborska.vercel.app/auth/coros/callback
# Must exactly match the redirect URI registered with COROS.
COROS_REDIRECT_URI=
# Optional: defaults to https://mcpeu.coros.com/mcp (host with or without /mcp).
COROS_MCP_URL=
# Shared secret guarding the /test/coros/connection endpoint (PoC probe).
COROS_TEST_SECRET=
# Only used by scripts/coros_detail_test.py (manual debugging, not the app).
# COROS_ACCESS_TOKEN=
# COROS_REFRESH_TOKEN=

# --- Wahoo (OAuth) ------------------------------------------------------------
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
# Optional: defaults to https://tourdemalborska.vercel.app/auth/wahoo/callback
WAHOO_REDIRECT_URI=
# Optional: defaults to https://api.wahooligan.com
WAHOO_HOST=

# --- Hammerhead Karoo (OAuth) -------------------------------------------------
HAMMERHEAD_CLIENT_ID=
HAMMERHEAD_CLIENT_SECRET=
# Optional: defaults to https://tourdemalborska.vercel.app/auth/hammerhead/callback
HAMMERHEAD_REDIRECT_URI=

# --- Garmin (Personal API key) ------------------------------------------------
GARMIN_API_KEY=
# Optional: defaults to https://personal.connectapi.garmin.com
GARMIN_HOST=

# --- Support page -------------------------------------------------------------
# Contact email shown on /support. Falls back to the school website if unset.
SUPPORT_EMAIL=

# --- Test-only --------------------------------------------------------------
# Used only by the /activities test endpoint. Not needed for normal operation.
STRAVA_ACCESS_TOKEN=