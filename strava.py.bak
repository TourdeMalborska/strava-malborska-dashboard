import os
import requests

from config import supabase
from datetime import datetime
from datetime import datetime, timedelta, UTC
from config import (
    STRAVA_CLIENT_ID,

    STRAVA_CLIENT_SECRET
)

def refresh_access_token(refresh_token: str):

    response = requests.post(
        "https://www.strava.com/oauth/token",
        data={
            "client_id": os.getenv("STRAVA_CLIENT_ID"),
            "client_secret": os.getenv("STRAVA_CLIENT_SECRET"),
            "grant_type": "refresh_token",
            "refresh_token": refresh_token
        }
    )

    response.raise_for_status()

    return response.json()
    
def refresh_athlete_token(athlete):

    token_data = refresh_access_token(
        athlete["refresh_token"]
    )

    expires_at = datetime.fromtimestamp(
        token_data["expires_at"]
    )

    supabase.table("athletes").update(
        {
            "refresh_token": token_data["refresh_token"],
            "expires_at": expires_at.isoformat()
        }
    ).eq(
        "strava_athlete_id",
        athlete["strava_athlete_id"]
    ).execute()

    return token_data["access_token"]

def get_activities(access_token):

    response = requests.get(
        "https://www.strava.com/api/v3/athlete/activities",
        headers={
            "Authorization": f"Bearer {access_token}"
        }
    )

    response.raise_for_status()

    return response.json()
    
def save_activities(activities):

    records = []

    for activity in activities:

        records.append(
            {
                "activity_id": activity["id"],
                "strava_athlete_id": activity["athlete"]["id"],
                "activity_date": activity["start_date"][:10],
                "distance": activity["distance"],
                "moving_time": activity["moving_time"],
                "sport_type": activity["sport_type"],
                "activity_name": activity["name"]
            }
        )

    result = (
        supabase
        .table("activities")
        .upsert(records)
        .execute()
    )

    return result
    
def get_yesterday_activities(access_token):

    activities = get_activities(access_token)

    yesterday = (
        datetime.now(UTC).date()
        - timedelta(days=1)
    )

    return [
        activity
        for activity in activities
        if datetime.fromisoformat(
            activity["start_date"].replace("Z", "+00:00")
        ).date() == yesterday
    ]

import time
from datetime import datetime, timezone, timedelta
import requests
from config import supabase

def _to_iso_utc(ts: int) -> str:
    return datetime.fromtimestamp(ts, tz=timezone.utc).isoformat()

def get_activities_range(access_token: str, start_ts: datetime, end_ts: datetime):
    url = "https://www.strava.com/api/v3/athlete/activities"
    headers = {"Authorization": f"Bearer {access_token}"}
    per_page = 200
    page = 1
    results = []

    while True:
        params = {
            "after": int(start_ts.timestamp()),
            "before": int(end_ts.timestamp()),
            "per_page": per_page,
            "page": page
        }

        resp = None
        for attempt in range(4):
            try:
                resp = requests.get(url, headers=headers, params=params, timeout=30)
                if resp.status_code == 429:
                    retry_after = int(resp.headers.get("Retry-After", "60"))
                    print(f"[strava] rate limited, sleeping {retry_after}s")
                    time.sleep(retry_after)
                    continue
                resp.raise_for_status()
                break
            except requests.RequestException as e:
                backoff = 2 ** attempt
                print(f"[strava] request error (attempt {attempt}) {e}, backoff {backoff}s")
                time.sleep(backoff)
        if resp is None:
            raise RuntimeError("Failed to fetch activities from Strava")

        data = resp.json()
        if not data:
            break
        results.extend(data)
        if len(data) < per_page:
            break
        page += 1

    return results

def save_activities(activities):
    if not activities:
        return {"status": "no_activities", "inserted": 0}

    records = []
    for activity in activities:
        records.append({
            "activity_id": activity["id"],
            "strava_athlete_id": activity["athlete"]["id"],
            "activity_date": activity.get("start_date", "")[:10],
            "distance": activity.get("distance"),
            "moving_time": activity.get("moving_time"),
            "sport_type": activity.get("sport_type"),
            "activity_name": activity.get("name"),
            "raw": activity
        })

    # Supabase upsert requires unique constraint on activity_id in DB
    result = supabase.table("activities").upsert(records).execute()
    return {"status": "ok", "data": result.data}

def get_yesterday_activities(access_token):
    today_utc = datetime.now(timezone.utc).date()
    yesterday = today_utc - timedelta(days=1)
    start_ts = datetime.combine(yesterday, datetime.min.time()).replace(tzinfo=timezone.utc)
    end_ts = datetime.combine(yesterday, datetime.max.time()).replace(tzinfo=timezone.utc)
    return get_activities_range(access_token, start_ts, end_ts)
