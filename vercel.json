{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/sync/daily",
      "schedule": "1 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/sync/daily",
      "dest": "/sync/daily"
    },
    {
      "src": "/sync/rolling",
      "dest": "/sync/rolling"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}